NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Public site origin used for Tranzzo result_url/server_url.
# Production must be HTTPS, e.g. https://petalyze.co
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only OpenAI settings. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2

# Tranzzo server-only credentials. Never prefix with NEXT_PUBLIC_.
TRANZZO_POS_ID=YOUR_POS_ID
TRANZZO_API_KEY=YOUR_API_KEY
TRANZZO_API_SECRET=YOUR_API_SECRET
TRANZZO_API_URL=https://cpay.tranzzo.com/api/v1/payment

# Safety switch. Keep false until v0.11.x payment flow is fully wired and tested.
TRANZZO_CHECKOUT_ENABLED=false
